{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wedding-invite",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    // Unmatched paths (e.g. /i/<code>) get the guest SPA shell.
    "not_found_handling": "single-page-application",
    // Only /api/* runs the Worker first; everything else is a free static asset.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wedding-invite",
      // Placeholder for local dev. Replace with the real id after `wrangler d1 create` (needs owner approval).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
